{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hah-dev:text-to-lattice-browser-evidence:1",
  "title": "Text to Lattice sanitized production browser evidence",
  "description": "A metadata-and-digests-only GATE-06 record plus two manually reviewed flattened PNG captures and the fixed sibling files TEXT-TO-LATTICE-DEPLOYMENT-EVIDENCE.before.json and TEXT-TO-LATTICE-DEPLOYMENT-EVIDENCE.after.json. The two deployment-index copies must be byte-identical, must hash to every recorded deployment-evidence digest, and must supply the recorded workflow, service-job, Worker, site-artifact, canonical-URL, and service-deployment evidence identities. Each browser record proves one bodyless same-origin visitor-session POST establishes the exact non-secret attributes of the API-scoped quota cookie before one content-bearing POST carries it, and that the transformation response does not rotate it. Raw HAR data, source, output, bodies, cookie values, authorization values, provider credentials, and sensitive header values are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "evidence_id",
    "recorded_at",
    "deployment",
    "redaction",
    "engines"
  ],
  "properties": {
    "format": {
      "const": "TEXT_TO_LATTICE_BROWSER_EVIDENCE"
    },
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ttl-browser-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "engines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/engine"
            },
            {
              "type": "object",
              "properties": {
                "engine_id": {
                  "const": "safari-webkit"
                },
                "browser_name": {
                  "const": "Safari"
                },
                "engine_name": {
                  "const": "WebKit"
                },
                "sanitized_capture": {
                  "type": "object",
                  "properties": {
                    "basename": {
                      "const": "TEXT-TO-LATTICE-BROWSER-EVIDENCE.safari-webkit.png"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/engine"
            },
            {
              "type": "object",
              "properties": {
                "engine_id": {
                  "const": "brave-chromium"
                },
                "browser_name": {
                  "const": "Brave"
                },
                "engine_name": {
                  "const": "Chromium"
                },
                "sanitized_capture": {
                  "type": "object",
                  "properties": {
                    "basename": {
                      "const": "TEXT-TO-LATTICE-BROWSER-EVIDENCE.brave-chromium.png"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "deployment": {
      "type": "object",
      "description": "Workflow-emitted deployment identifiers plus the SHA-256 digest of one static deployment-evidence index copied to the two fixed sibling filenames immediately before and after the captures. The service-deployment evidence time is the post-live-verification deployment-index generation time. Bundle verification rehashes both copies and compares their closed identity fields; these fields do not claim an independent live identity probe.",
      "additionalProperties": false,
      "required": [
        "deployed_commit",
        "workflow_run_id",
        "workflow_run_attempt",
        "workflow_run_url",
        "service_job_id",
        "canonical_url",
        "api_worker_deployment_id",
        "api_worker_version",
        "response_policy_worker_deployment_id",
        "response_policy_worker_version",
        "deployment_evidence_index_sha256",
        "deployment_evidence_before_captures_sha256",
        "deployment_evidence_after_captures_sha256",
        "site_artifact_sha256",
        "qualified_source_set_sha256",
        "deployed_at",
        "qualification_expires_at",
        "deployment_evidence_checked_before_captures_at",
        "deployment_evidence_checked_after_captures_at",
        "deployment_evidence_unchanged_across_captures"
      ],
      "properties": {
        "deployed_commit": {
          "type": "string",
          "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
        },
        "workflow_run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "workflow_run_attempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}$"
        },
        "workflow_run_url": {
          "type": "string",
          "pattern": "^https://github\\.com/howardhayden/folio/actions/runs/[1-9][0-9]{0,19}$"
        },
        "service_job_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "canonical_url": {
          "const": "https://hah.dev/resume/#text-to-lattice"
        },
        "api_worker_deployment_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "api_worker_version": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "response_policy_worker_deployment_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "response_policy_worker_version": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "deployment_evidence_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_evidence_before_captures_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "deployment_evidence_after_captures_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "site_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "qualified_source_set_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the exact qualified source set recomputed before the guarded qualification-pending deployment and retained in both deployment-evidence snapshots."
        },
        "deployed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "qualification_expires_at": {
          "$ref": "#/$defs/timestamp",
          "description": "The workflow-generated absolute end of the guarded qualification-pending exposure. Both captures and the post-capture deployment-index check must complete no later than this instant."
        },
        "deployment_evidence_checked_before_captures_at": {
          "$ref": "#/$defs/timestamp"
        },
        "deployment_evidence_checked_after_captures_at": {
          "$ref": "#/$defs/timestamp"
        },
        "deployment_evidence_unchanged_across_captures": {
          "const": true
        }
      }
    },
