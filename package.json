{
  "name": "hayden-portfolio",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-build-output.mjs && npm run docs:lattice:check && npm run release:lattice:verify && npm run typecheck && node scripts/validate-ascii-character.mjs && vinext build",
    "build:pages": "npm run build && node scripts/build-pages.mjs && npm run release:lattice:verify:site",
    "docs:lattice": "node scripts/docs/build-text-to-lattice-documentation.mjs",
    "docs:lattice:check": "node scripts/docs/build-text-to-lattice-documentation.mjs --check",
    "release:lattice:verify": "node scripts/verify-text-to-lattice-release.mjs --source",
    "release:lattice:verify:site": "node scripts/verify-text-to-lattice-release.mjs --source --site",
    "release:lattice:verify:wasm": "node scripts/fetch-lattice-wasm.mjs",
    "start": "vinext start",
    "test": "npm run build:pages && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern site"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.82",
    "@mlc-ai/web-tokenizers": "0.1.6",
    "bootstrap": "4.6.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2"
  },
  "type": "module",
  "displayName": "Hayden Howard Portfolio"
}
