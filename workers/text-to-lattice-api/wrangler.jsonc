{
  "name": "hahdev-text-to-lattice-api",
  "main": "entry.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "routes": [
    {
      "pattern": "hah.dev/api/lattice",
      "zone_name": "hah.dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LATTICE_TRANSFORMATION_BUDGET",
        "class_name": "LatticeTransformationBudget"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "LATTICE_API_RATE_LIMITER",
      "namespace_id": "857321",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LatticeTransformationBudget"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
