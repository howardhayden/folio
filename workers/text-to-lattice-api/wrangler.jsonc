{
  "name": "hahdev-text-to-lattice-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "routes": [
    {
      "pattern": "hah.dev/api/lattice",
      "zone_name": "hah.dev"
    }
  ],
  "ratelimits": [
    {
      "name": "LATTICE_API_RATE_LIMITER",
      "namespace_id": "857321",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
